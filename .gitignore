# Build artifacts (see packaging/ -- these are regenerated by
# packaging/build_macos.sh / build_windows.bat / build_linux.sh, and by
# GitHub Actions on every tagged release; nothing here is hand-edited)
build/
dist/
packaging/.build-venv/
packaging/.icons-venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# This app's own data lives at ~/.jira_timesheet/timesheet.db, outside the
# repo -- these patterns are just a safety net in case a stray db/backup
# file ever ends up inside the repo folder itself.
*.db
*.sqlite
*.sqlite3

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Test artifacts
.pytest_cache/
app/theme.py.bak
